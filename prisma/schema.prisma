// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/"
}

datasource db {
  provider = "postgresql"
}

model League {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  active    Boolean    @default(false)
  archived  Boolean    @default(false)
  seasons   Season[]
  divisions Division[]
  teams     Team[]
  Player    Player[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  Game      Game[]
}

model Season {
  id         Int         @id @default(autoincrement())
  name       String
  active     Boolean     @default(false)
  archived   Boolean     @default(false)
  divisions  Division[]
  leagueId   Int
  league     League      @relation(fields: [leagueId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
  game       Game[]
  teamLogs   TeamLog[]
  playerLogs PlayerLog[]
}

model Division {
  id         Int         @id @default(autoincrement())
  name       String
  active     Boolean     @default(false)
  archived   Boolean     @default(false)
  teams      Team[]
  seasonId   Int
  leagueId   Int
  season     Season      @relation(fields: [seasonId], references: [id])
  league     League      @relation(fields: [leagueId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
  game       Game[]
  teamLogs   TeamLog[]
  playerLogs PlayerLog[]
}

model Team {
  id         Int          @id @default(autoincrement())
  name       String
  shortName  String
  active     Boolean      @default(false)
  archived   Boolean      @default(false)
  divisionId Int
  leagueId   Int
  division   Division     @relation(fields: [divisionId], references: [id])
  league     League       @relation(fields: [leagueId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  players    TeamPlayer[]
  teamLogs   TeamLog[]
  playerLogs PlayerLog[]
}

enum Position {
  POINT_GUARD
  SHOOTING_GUARD
  SMALL_FORWARD
  POWER_FORWARD
  CENTER
}

model Player {
  id         Int          @id @default(autoincrement())
  name       String
  position   Position
  number     String
  height     String
  active     Boolean      @default(false)
  archived   Boolean      @default(false)
  leagueId   Int
  league     League       @relation(fields: [leagueId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  teams      TeamPlayer[]
  playerLogs PlayerLog[]
}

// The explicit join table model
model TeamPlayer {
  playerId   Int
  teamId     Int
  team       Team     @relation(fields: [teamId], references: [id])
  player     Player   @relation(fields: [playerId], references: [id])
  assignedAt DateTime @default(now())

  @@id([playerId, teamId]) // composite primary key
}

enum GamePhase {
  PRE_SEASON
  REGULAR_SEASON
  POST_SEASON
}

model Game {
  id         Int         @id @default(autoincrement())
  date       DateTime
  phase      GamePhase
  round      Int
  active     Boolean     @default(false)
  archived   Boolean     @default(false)
  leagueId   Int
  seasonId   Int
  divisionId Int
  league     League      @relation(fields: [leagueId], references: [id])
  season     Season      @relation(fields: [seasonId], references: [id])
  division   Division    @relation(fields: [divisionId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
  teamLogs   TeamLog[]
  playerLogs PlayerLog[]
}

enum TeamSide {
  AWAY_TEAM
  HOME_TEAM
}

model TeamLog {
  id         Int         @id @default(autoincrement())
  side       TeamSide
  score      Int
  byPeriod   Int[]
  gameId     Int
  seasonId   Int
  divisionId Int
  teamId     Int
  game       Game        @relation(fields: [gameId], references: [id])
  season     Season      @relation(fields: [seasonId], references: [id])
  division   Division    @relation(fields: [divisionId], references: [id])
  team       Team        @relation(fields: [teamId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
  playerLogs PlayerLog[]
}

model PlayerLog {
  started        Boolean  @default(false)
  seconds        Int      @default(0)
  fgMade         Int      @default(0)
  fgAttempted    Int      @default(0)
  fg3Made        Int      @default(0)
  fg3Attempted   Int      @default(0)
  ftMade         Int      @default(0)
  ftAttempted    Int      @default(0)
  points         Int      @default(0)
  offRebounds    Int      @default(0)
  defRebounds    Int      @default(0)
  rebounds       Int      @default(0)
  assists        Int      @default(0)
  steals         Int      @default(0)
  blocks         Int      @default(0)
  turnovers      Int      @default(0)
  personalFouls  Int      @default(0)
  technicalFouls Int      @default(0)
  teamLogId      Int
  seasonId       Int
  divisionId     Int
  playerId       Int
  teamId         Int
  gameId         Int
  teamLog        TeamLog  @relation(fields: [teamLogId], references: [id])
  season         Season   @relation(fields: [seasonId], references: [id])
  division       Division @relation(fields: [divisionId], references: [id])
  team           Team     @relation(fields: [teamId], references: [id])
  player         Player   @relation(fields: [playerId], references: [id])
  game           Game     @relation(fields: [gameId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@id([teamLogId, playerId, teamId]) // composite primary key
}

enum UserRole {
  GUEST
  USER
  MANAGER
  ADMINISTRATOR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
